# Unreal Engine generated folders
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
Platforms/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# IDE / project files (regenerate with "Generate Visual Studio project files")
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.xcworkspace
*.xcodeproj
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
compile_commands.json

# Core test build output
Tests/build/
build/

# OS clutter
.DS_Store
Thumbs.db

# Stand-ins for Unreal Header Tool output, rebuilt by Tests/check_engine.py on every run.
Tests/UnrealStub/*.generated.h

# Raw art downloads; the imported .uasset files under Content/Art are what get committed.
ArtSource/

# Imported models keep their full scanned geometry (the pine alone is ~600 MB), so they are rebuilt
# locally from Tools/Art/fetch_models.py + import_models.py rather than committed. The game falls back
# to generated plants without them.
Content/Art/Models/
__pycache__/

# NVIDIA DLSS / Streamline plugins: ~2 GB, installed by Tools/fetch_dlss.py, used under NVIDIA's licence.
Plugins/DLSS/
Plugins/Streamline*/

# Epic's UE5 mannequins, copied from the engine by Tools/fetch_mannequins.py (126 MB, Unreal Engine EULA).
Content/Characters/
